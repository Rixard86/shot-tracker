/* ShotPuck pin control. Pins chosen from the MDBT50Q bottom pad row. */
&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 6)>,
				<NRF_PSEL(TWIM_SDA, 0, 4)>;
			bias-pull-up;   /* internal pull-ups */
		};
	};
	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 6)>,
				<NRF_PSEL(TWIM_SDA, 0, 4)>;
			low-power-enable;
		};
	};
};
